# Copiá este archivo como .env (local) o cargá estas variables en Vercel
ADMIN_EMAIL=admin@emuna.com
ADMIN_PASSWORD=
SESSION_SECRET=
# Postgres (Neon / Vercel Postgres / Supabase). Vacío = base embebida en ./data
DATABASE_URL=
# Recuperar contraseña por email (https://resend.com)
RESEND_API_KEY=
MAIL_FROM=EMUNÁ <hola@tudominio.com>
SITE_URL=
# Anti-bots Cloudflare Turnstile (opcional)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Borrar usuarios de prueba: poner 1
DISABLE_TEST_USERS=
